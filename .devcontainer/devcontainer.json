{
  "name": "Apoio · Portal",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "support_portal/api.py",
        "support_portal/templates/portal.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo '✅ Dependencies ready'",
  "postAttachCommand": {
    "server": "python -m flask --app support_portal.api run --host 0.0.0.0 --port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Apoio portal",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
